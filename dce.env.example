# Fill with approved departmental values. No secrets are supplied.
SDC_ORIGIN=https://legal.department.example
SDC_DATABASE=/var/lib/dce/register.sqlite
SDC_REGISTER_OWNER_EMAIL=administrator@department.example
SDC_OIDC_ISSUER=https://identity.department.example
SDC_OIDC_CLIENT_ID=replace-with-approved-client-id
SDC_OIDC_CLIENT_SECRET=
# Optional API JWT audience for machine/MCP clients. Leave empty to reject bearer API access.
SDC_OIDC_API_AUDIENCE=
HOST=127.0.0.1
PORT=8080
DCE_NOTIFICATIONS_ENABLED=no
DCE_NOTIFICATION_URL=
DCE_NOTIFICATION_SECRET=
DCE_RUNNER_ENABLED=no
DCE_RUNNER_SECRET=
DCE_RUNNER_ADMIN_EMAIL=
